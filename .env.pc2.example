# ============================================================
# PC-2 (Remote Storage Node) .env
# Copy this file to .env on PC-2 and adjust as needed.
# ============================================================

# Database connection - points to PC-1's MySQL
DB_HOST=192.168.1.10
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123
DB_NAME=dfms_db

# Shared token - MUST be identical on all PCs
NODE_SHARED_TOKEN=replace-with-the-same-long-random-token-on-every-node
NODE_REQUEST_TIMEOUT_SECONDS=15

# PC-2 Node Agent settings (used when running node_agent.py on PC-2)
NODE_NAME=pc-2-node
NODE_STORAGE_DIR=./node_storage_pc2
NODE_AGENT_HOST=0.0.0.0
NODE_AGENT_PORT=7002