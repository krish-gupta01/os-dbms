# ============================================================
# PC-1 (Main Server) .env
# Copy this file to .env on PC-1 and adjust as needed.
# ============================================================

# Flask app settings
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# Database (MySQL on this PC)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123
DB_NAME=dfms_db

# File upload / chunk settings
MAX_UPLOAD_MB=1024
REPLICATION_FACTOR=2
CHUNK_SIZE_MB=4

# Shared token - MUST be identical on all PCs
NODE_SHARED_TOKEN=replace-with-the-same-long-random-token-on-every-node
NODE_REQUEST_TIMEOUT_SECONDS=15

# PC-1 Node Agent settings (used when running node_agent.py on PC-1)
PC1_NODE_NAME=pc-1-node
PC1_NODE_URL=http://127.0.0.1:7001
PC1_STORAGE_DIR=./node_storage_pc1
PC1_CAPACITY_MB=10240
NODE_NAME=pc-1-node
NODE_STORAGE_DIR=./node_storage_pc1
NODE_AGENT_HOST=0.0.0.0
NODE_AGENT_PORT=7001

# PC-2 Node settings (used by seed.py to register the remote node)
# If PC-2 is on a different network, use its public IP or LAN IP
PC2_NODE_NAME=pc-2-node
PC2_NODE_URL=http://192.168.1.100:7002
PC2_STORAGE_DIR=./node_storage_pc2
PC2_CAPACITY_MB=10240